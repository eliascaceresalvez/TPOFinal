# Crear el archivo .gitignore
@"
# Dependencias
node_modules/
backend/node_modules/
frontend/node_modules/

# Variables de entorno
.env
.env.local
.env.production
backend/.env
frontend/.env

# Archivos de sistema
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Builds
dist/
build/

# IDE
.vscode/
.idea/

# MongoDB
*.mongodb

# Archivos temporales de prueba
test-*.js
backend/test-*.js
"@ | Out-File -FilePath .gitignore -Encoding utf8